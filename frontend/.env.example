# Backend API base (without the trailing /api/v1 path segment consumers add)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000/api/v1
# The public address of the site, for example https://siyaf.com. Used for every absolute URL.
NEXT_PUBLIC_SITE_URL=https://siyaf.vercel.app

# Meta Embedded Signup (WhatsApp connect step in onboarding)
NEXT_PUBLIC_META_APP_ID=your_meta_app_id_here
NEXT_PUBLIC_META_CONFIG_ID=your_meta_config_id_here

# When true, every data hook returns data from src/lib/mock/* instead of
# calling the real API — lets the full design be built/reviewed ahead of
# backend support. See frontend/APPLY_DESIGN.md.
NEXT_PUBLIC_USE_MOCKS=true
