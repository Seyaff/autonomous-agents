# =your_# _here
# 1. SERVER & APPLICATION SETTINGS
# =your_# _here
PROJECT_NAME=your_project_name_here
PORT=your_port_here
NODE_ENV=your_node_env_here
APP_ENV=your_app_env_here
DEBUG=your_debug_here
SECRET_KEY=your_secret_key_here


# MongoDB (kept for your existing legacy / external services):
MONGO_URI=your_mongo_uri_here
USE_DB_SESSIONS=your_use_db_sessions_here
DATABASE_NAME=your_database_name_here

# Redis Cache & Message Queue
REDIS_URL=your_redis_url_here

# =your_# _here
# 3. META WHATSAPP CLOUD API (TEST NUMBER & WEBHOOK)
# =your_# _here
APP_ID=your_app_id_here
APP_SECRET=your_app_secret_here

WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_TOKEN=your_whatsapp_token_here

WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here

HF_TOKEN=your_hf_token_here

# =your_# _here
# 4. RESTAURANT & OPERATIONAL PHONES
# =your_# _here
DEFAULT_RESTAURANT_ID=your_default_restaurant_id_here
# Restaurant Owner WhatsApp line (messages from this number trigger Inventory / 86 commands):
OWNER_WHATSAPP_PHONE=your_owner_whatsapp_phone_here

# Platform Founder WhatsApp line (messages from this number trigger BizOps Agent):
FOUNDER_PHONE_NUMBER=your_founder_phone_number_here

# =your_# _here
# 5. AI MODEL PROVIDERS
# =your_# _here
# Google Gemini (for vision PDF OCR and fast conversational reasoning):
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key_here

# Payments: 'dummy' is the only provider for now. It charges nothing.
PAYMENTS_PROVIDER=dummy

# Which provider agents use: 'groq' in dev/testing, 'openai' in production.
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_MODEL=gpt-4.1

# Groq (ultra-low latency inference, used in dev/testing):
GROQ_API_KEY=your_groq_api_key_here
# OpenAI (used in production):
OPENAI_API_KEY=your_openai_api_key_here

# =your_# _here
# 6. SCRAPING & LEAD SEARCH ENGINES (PHASE 3)
# =your_# _here
# Apify (for Google Maps restaurant scraping & lead enrichment):
APIFY_TOKEN=your_apify_token_here

# Tavily (for real-time web search and restaurant menu auditing):
TAVILY_API_KEY=your_tavily_api_key_here

# Pinecone Vector Database (optional cloud vector index):
PINECONE_API_KEY=your_pinecone_api_key_here

# Storage for uploaded menus
STORAGE_DIR=your_storage_dir_here


META_PERMANENT_ACCESS_TOKEN=your_meta_permanent_access_token_here




GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=your_google_callback_url_here


FRONTEND_ORIGIN=your_frontend_origin_here
JWT_SECRET_KEY=your_jwt_secret_key_here
SESSION_SECRET_KEY=your_session_secret_key_here


JWT_ALGORITHM=your_jwt_algorithm_here

# One-time secret to create the single FOUNDER account via
# POST /api/v1/auth/bootstrap-founder. Leave blank to disable the route
# entirely once the founder account has been created.
FOUNDER_BOOTSTRAP_SECRET=your_founder_bootstrap_secret_here


LANGSMITH_TRACING=your_langsmith_tracing_here
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=your_langsmith_project_here
