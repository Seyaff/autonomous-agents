# Application
APP_NAME=Autonomous Restaurant Operations Platform
APP_ENV=development
DEBUG=true
PORT=8000
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Meta WhatsApp Cloud API Configuration
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=restaurant_agents_webhook_secret_verify_token

# Founder WhatsApp Configuration
FOUNDER_PHONE_NUMBER=

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/autonomous_agents
# Optional fallback for local dev if Postgres is not running:
# DATABASE_URL=sqlite+aiosqlite:///./test.db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# AI Models & Providers
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Storage (Local or S3/Supabase)
STORAGE_DIR=./uploads
